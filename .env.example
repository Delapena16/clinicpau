# Local environment settings for Dr. Pau Animal Bite Center
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/dr_pau_pep_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:5000

# Set these only when running the test/reset scripts.
ADMIN_TEST_PASSWORD=
PHYSICIAN_TEST_PASSWORD=
RECEPTIONIST_TEST_PASSWORD=
